# Copy to .env (gitignored). Compose and Makefile read this file.

# LLM providers (leave empty to use the fake provider)
OPENAI_API_KEY=
GOOGLE_API_KEY=

# API security - comma-separated keys
APP_API_KEYS=local-dev-key
APP_ADMIN_API_KEYS=local-admin-key

# Local infrastructure
POSTGRES_USER=llm
POSTGRES_PASSWORD=llm-local
