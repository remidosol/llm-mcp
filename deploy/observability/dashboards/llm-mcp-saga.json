{
  "title": "llm-mcp \u2014 saga, outbox, LLM, resilience",
  "uid": "llm-mcp-saga",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "llm-mcp"
  ],
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Saga funnel: transitions/min",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (to) (rate(saga_transition_total[5m])*60)",
          "legendFormat": "-> {{to}}"
        }
      ],
      "fieldConfig": {
        "defaults": {}
      },
      "options": {}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Guard rejections & late results",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (from,to) (rate(saga_guard_rejected_total[5m])*60) or sum(rate(saga_late_result_total[5m])*60)",
          "legendFormat": "{{from}}->{{to}}"
        }
      ],
      "fieldConfig": {
        "defaults": {}
      },
      "options": {}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Outbox pending rows",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "outbox_pending",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {}
      },
      "options": {}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Outbox publish latency p95",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le,service) (rate(outbox_publish_latency_seconds_bucket[5m])))",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "options": {}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Inbox duplicates & DLT messages/min",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (rate(inbox_duplicate_total[5m])*60) or sum by (topic) (rate(dlt_messages_total[5m])*60)",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {}
      },
      "options": {}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "LLM call latency p95 by provider/outcome",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le,provider,outcome) (rate(llm_call_seconds_bucket[5m])))",
          "legendFormat": "{{provider}}/{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "options": {}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Tokens/min by provider",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (provider,kind) (rate(llm_tokens_total[5m])*60)",
          "legendFormat": "{{provider}} {{kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {}
      },
      "options": {}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Circuit breaker state (1 = in that state)",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "resilience4j_circuitbreaker_state",
          "legendFormat": "{{name}} {{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {}
      },
      "options": {}
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Rate limit rejections/min",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (provider) (rate(ratelimit_rejected_total[5m])*60)",
          "legendFormat": "{{provider}}"
        }
      ],
      "fieldConfig": {
        "defaults": {}
      },
      "options": {}
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Kafka consumer lag (max, by group)",
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (client_id) (kafka_consumer_fetch_manager_records_lag_max)",
          "legendFormat": "{{client_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {}
      },
      "options": {}
    }
  ],
  "templating": {
    "list": []
  }
}